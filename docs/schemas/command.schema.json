{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "cmd_id": { "type": "string", "pattern": "^CMD-[a-f0-9]{5}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "command": { "type": "string", "enum": ["set_mode", "go_to_angle", "stop", "home"] },
    "params": { "type": "object" }
  },
  "required": ["schema_version", "cmd_id", "created_at", "expires_at", "command"],
  "additionalProperties": false
}
