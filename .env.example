# ── MQTT broker ───────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=solartracker
MQTT_PASSWORD=changeme

# ── Backend API ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=changeme-api-key

# ── SQLite database path ───────────────────────────────────────
DB_PATH=./solar_tracker.db

# ── Device ID ─────────────────────────────────────────────────
DEVICE_ID=tracker-01

# ── Location for pvlib solar-position calculations ────────────
# Use decimal degrees. Altitude in metres.
LATITUDE=0.0
LONGITUDE=0.0
ALTITUDE=0.0
TIMEZONE=UTC

# ── Data retention ────────────────────────────────────────────
# Keep raw high-frequency telemetry for N days before aggregation
RAW_RETENTION_DAYS=7
